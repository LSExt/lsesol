#!/sbin/sh
# /var/sadm/pkg/LSEpftpd/install/postinstall

GROUPADD=/usr/sbin/groupadd
USERADD=/usr/sbin/useradd
GREP=/usr/bin/grep
MKDIR=/usr/bin/mkdir
MKNOD=/usr/sbin/mknod

PREFIX=/usr/local/lse
CONFDIR=${PREFIX}/etc
ANONFTPDIR=${PREFIX}/var/proftpd

$GREP '^ftp:' /etc/group >/dev/null 2>&1
if [ $? -ne 0 ]; then
    echo "Creating group 'ftp'..."
    $GROUPADD ftp 2>/dev/null || true
fi

$GREP '^ftp:' /etc/passwd >/dev/null 2>&1
if [ $? -ne 0 ]; then
    echo "Creating user 'ftp'..."
    $USERADD -g ftp -d "${ANONFTPDIR}" -s /bin/false -c "Anonymous FTP" ftp 2>/dev/null || true
fi

for config in proftpd.conf; do
    if [ ! -f "${CONFDIR}/$config" ] ; then
        cp -p ${CONFDIR}/$config.default ${CONFDIR}/$config
        echo "Installing new $config"
    else
        echo "Keeping existing $config"
    fi
done

# 4. Create dedicated anonymous chroot tree and device nodes
[ -d "${ANONFTPDIR}" ] || $MKDIR -p "${ANONFTPDIR}"
[ -d "${ANONFTPDIR}/dev" ] || $MKDIR -p "${ANONFTPDIR}/dev"
chmod 755 "${ANONFTPDIR}" "${ANONFTPDIR}/dev"
chown ftp:ftp "${ANONFTPDIR}" 2>/dev/null || true

cd "${ANONFTPDIR}"
[ -c dev/tcp ]        || $MKNOD dev/tcp c 11 42
[ -c dev/udp ]        || $MKNOD dev/udp c 11 41
[ -c dev/zero ]       || $MKNOD dev/zero c 13 12
[ -c dev/ticotsord ]  || $MKNOD dev/ticotsord c 105 1
# the following are needed in solaris 2.5.1
[ -c dev/ticlts ]     || $MKNOD dev/ticlts c 105 2
[ -c dev/ticots ]     || $MKNOD dev/ticots c 105 0

# Disable standard in.ftpd in /etc/inetd.conf if active
if $GREP '^ftp' /etc/inetd.conf >/dev/null 2>&1; then
    echo "Disabling in.ftpd in /etc/inetd.conf..."
    cp -p /etc/inetd.conf /etc/inetd.conf.pre-proftpd
    ${PREFIX}/bin/gsed -i 's|^ftp|#ftp|' /etc/inetd.conf 2>/dev/null || \
        sed 's|^ftp|#ftp|' /etc/inetd.conf > /etc/inetd.conf.tmp && mv /etc/inetd.conf.tmp /etc/inetd.conf

    # Reload inetd on 
    INETD_PID=`ps -ef | $GREP inetd | $GREP -v grep | awk '{print $2}'`
    if [ -n "$INETD_PID" ]; then
        echo "Reloading inetd (PID $INETD_PID)..."
        kill -HUP $INETD_PID
    fi
fi

exit 0
