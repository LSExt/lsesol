+#ifndef USE_NEW_PROC
+#define MAX_BAD_PIDS 64
+static pid_t bad_pids[MAX_BAD_PIDS];
+static int num_bad_pids = 0;
+
+static int
+is_pid_blacklisted(pid_t pid)
+{
+    int i;
+    for (i = 0; i < num_bad_pids; i++) {
+        if (bad_pids[i] == pid)
+            return 1;
+    }
+    return 0;
+}
+
+static void
+blacklist_pid(pid_t pid)
+{
+    if (num_bad_pids < MAX_BAD_PIDS && !is_pid_blacklisted(pid)) {
+        bad_pids[num_bad_pids++] = pid;
+    }
+}
+
+static int
+is_proc_safe(const char *name)
+{
+    pid_t target_pid = (pid_t)atoi(name);
+    pid_t child;
+    int status;
+    int attempts;
+
+    /* 1. Fast path: check if we already flagged this process as hung */
+    if (is_pid_blacklisted(target_pid))
+        return 0;
+
+    /* 2. Fork sacrificial worker */
+    child = fork();
+    if (child < 0) {
+        /* Fork failed (system out of proc table space), attempt open anyway */
+        return 1;
+    }
+
+    if (child == 0) {
+        /* CHILD: test the open */
+        int fd = open(name, O_RDONLY | O_NONBLOCK);
+        if (fd >= 0) {
+            close(fd);
+            _exit(0);
+        }
+        _exit(1);
+    }
+
+    /* PARENT: Poll waitpid with WNOHANG up to ~150ms */
+    for (attempts = 0; attempts < 15; attempts++) {
+        pid_t ret = waitpid(child, &status, WNOHANG);
+        if (ret == child) {
+            /* Child completed: PID is safe to open */
+            return 1;
+        }
+        /* Sleep 10 milliseconds */
+        poll(NULL, 0, 10);
+    }
+
+    /* 
+     * TIMEOUT EXPIRED: Child is frozen inside kernel pr_open().
+     * Signal child to die whenever kernel lock clears, and blacklist target PID.
+     */
+    kill(child, SIGKILL);
+    waitpid(child, &status, WNOHANG); /* Try to reap if already ready */
+    blacklist_pid(target_pid);
+
+    return 0; /* Unsafe process, skip it! */
+}
